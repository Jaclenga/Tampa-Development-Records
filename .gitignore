# Runtime orchestration logs contain machine-local paths and remain local.
data/logs/

# Operational month-end files can contain local command paths. The sanitized
# Accela CSV/JSON snapshots and their hash manifest remain eligible to commit.
data/frozen/accela/**/collection.log
data/frozen/accela/**/status.json
# Atomic Accela writers use hidden random-suffix sidecars before replacing the
# final CSV. They are incomplete runtime files and must never be staged.
data/processed/.accela_*.csv.*

# The expanded Accela CSV now exceeds ordinary Git hosting limits. The
# deterministic .csv.gz artifact is published; this reproducible local copy is
# retained only as a working output.
data/integrated/tampa_development_activity_with_accela.csv
